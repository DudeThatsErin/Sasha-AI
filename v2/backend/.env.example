# Sasha AI v2 Backend Environment Variables
# Copy this file to .env and fill in your values

# Ollama settings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Environment
SASHA_ENV=production

# RAG settings
RAG_TOP_K=6
CHROMA_PERSIST_DIR=./chroma_db

# Auth
SECRET_KEY=change-this-to-a-long-random-secret
ADMIN_PASSWORD=change-this-password

# Discord Bot (required for knowledge approval flow)
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_server_id_here
DISCORD_CHANNEL_ID=your_channel_id_here
DISCORD_OWNER_ID=your_discord_user_id_here

# Internal URLs (leave as defaults unless you change ports)
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
DISCORD_NOTIFY_URL=http://127.0.0.1:8001/notify-pending
DISCORD_WIDGET_URL=http://127.0.0.1:8001/notify-widget
DISCORD_NOTIFY_PORT=8001
